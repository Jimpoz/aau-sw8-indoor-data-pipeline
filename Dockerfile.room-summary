FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_CONFIG_PATH=/app/modelConfig.cfg \
    ROOM_SUMMARY_CACHE_DIR=/app/.cache

ARG DOWNLOAD_DEFAULT_YOLO_MODEL=1
ARG MODEL_DOWNLOAD_PROFILE=

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.room-summary.txt /app/requirements.room-summary.txt
RUN pip install --no-cache-dir -r /app/requirements.room-summary.txt

COPY modelConfig.cfg /app/modelConfig.cfg
COPY room_summary/__init__.py /app/room_summary/__init__.py
COPY room_summary/download_model.py /app/room_summary/download_model.py
COPY room_summary/model_config.py /app/room_summary/model_config.py
COPY room_summary/model_download.py /app/room_summary/model_download.py
COPY room_summary/runtime_env.py /app/room_summary/runtime_env.py

RUN if [ "$DOWNLOAD_DEFAULT_YOLO_MODEL" = "1" ]; then \
        if [ -n "$MODEL_DOWNLOAD_PROFILE" ]; then \
            python -m room_summary.download_model --config /app/modelConfig.cfg --profile "$MODEL_DOWNLOAD_PROFILE"; \
        else \
            python -m room_summary.download_model --config /app/modelConfig.cfg; \
        fi; \
    fi

COPY . /app

EXPOSE 8000

CMD ["uvicorn", "middleware:app", "--host", "0.0.0.0", "--port", "8000"]
