FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.pathfinding.txt /app/requirements.pathfinding.txt
RUN pip install --no-cache-dir -r /app/requirements.pathfinding.txt

COPY . /app

EXPOSE 6969

CMD ["uvicorn", "pathfinding_main:app", "--host", "0.0.0.0", "--port", "6969"]
